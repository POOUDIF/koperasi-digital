# Salin file ini menjadi .env dan sesuaikan nilainya
# cp .env.example .env

# --- Server ---
SERVER_PORT=8080
APP_ENV=development   # development | production

# --- JWT ---
# Generate dengan: openssl rand -base64 32
JWT_SECRET=ganti-dengan-secret-yang-kuat-minimal-32-karakter
JWT_TOKEN_TTL_HOURS=24

# --- Database PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=rahasia
DB_NAME=koperasi_digital
DB_SSLMODE=disable

# --- Connection Pool ---
# MaxOpenConns  : batas total koneksi aktif ke database
# MaxIdleConns  : koneksi yang tetap hidup di pool saat idle (harus <= MaxOpenConns)
# ConnMaxLifetimeSec : berapa detik sebuah koneksi boleh hidup (0 = selamanya)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME_SEC=300

# --- Frontend / CORS ---
# Origin yang diizinkan mengakses API ini.
# Development: http://localhost:3000
# Production : https://domain-frontend-kamu.com
FRONTEND_URL=http://localhost:3000

# --- Blockchain Web3 (Polygon Amoy Testnet) ---
# Alchemy : https://polygon-amoy.g.alchemy.com/v2/<YOUR_API_KEY>
# Infura  : https://polygon-amoy.infura.io/v3/<YOUR_PROJECT_ID>
# Public  : https://rpc-amoy.polygon.technology  (tanpa API key, rate-limited)
# Kosongkan untuk menonaktifkan fitur blockchain (server tetap jalan normal).
POLYGON_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY_HERE
